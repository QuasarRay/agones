{
  "schema_version": 1,
  "rust": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "crates/**",
    "install/helm/agones/**",
    "verification/agones/go-print-*",
    "verification/agones/go-quote-ascii-reference.json",
    "verification/agones/feature-gates.ir.json",
    "verification/agones/feature-error-witnesses.json",
    "verification/agones/sdk-version.ir.json",
    "verification/agones/sdk-version-codegen.json",
    "verification/agones/sdk-version-witnesses.json",
    ".cargo/**",
    "verification/agones/gameserver-validation.ir.json",
    "verification/agones/gameserver-validation-codegen.json",
    "verification/agones/expected-multiset-relation.json"
  ],
  "model": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "crates/agones-core/**",
    "crates/agones-macros/**",
    "build/scripts/agones-rs/summarize_bool_proof.py",
    "build/scripts/agones-rs/summarize_feature_proof.py",
    "build/scripts/agones-rs/kani_results.py",
    "build/scripts/agones-rs/test_kani_results.py",
    "build/scripts/agones-rs/run.py",
    ".github/workflows/rust.yml",
    "AGONES_RS_CONTINUATION_PROMPT.md",
    "verification/agones/check-dependencies.json",
    "verification/agones/go-print-*",
    "verification/agones/feature-error-properties.json",
    "verification/agones/feature-query-codegen.json",
    "verification/agones/feature-gates.ir.json",
    "verification/agones/sdk-version.ir.json",
    "verification/agones/sdk-version-codegen.json",
    "verification/agones/sdk-version-domain.json",
    ".cargo/**",
    "verification/agones/gameserver-defaulting.ir.json",
    "verification/agones/gameserver-defaulting-codegen.json",
    "verification/agones/gameserver-feature-validation.ir.json",
    "verification/agones/gameserver-feature-validation-codegen.json",
    "verification/agones/gameserver-feature-validation-domain.json",
    "crates/agones-rusternetes/examples/feature_case_codegen.rs",
    "crates/agones-rusternetes/examples/codegen/**",
    "build/scripts/agones-rs/protect_model.py",
    "build/scripts/agones-rs/test_ci_model_execution.py",
    "verification/agones/gameserver-validation.ir.json",
    "verification/agones/gameserver-validation-codegen.json",
    "verification/agones/expected-multiset-relation.json",
    "build/scripts/agones-rs/test_source_case_proofs.py"
  ],
  "metadata_only": [
    "**/AGENTS.MD",
    "AGENTS.MD",
    "AGONES_RS_STATE.json",
    "AGONES_RS_STATE.schema.json",
    "AGONES_RS_HANDOFF.md",
    "verification/agones/**",
    "build/scripts/agones-rs/**"
  ],
  "unknown_change_policy": "RUN_BOTH",
  "reuse_policy": "Always-run state validation checks retained source/artifact bindings. A successful nonempty model CI snapshot with available hash-bound proof artifacts may be reused only when its current declared model inputs match an ancestor snapshot. Policy extensions must be monotonic and their newly declared inputs unchanged. Unknown or changed inputs, failed/skipped/empty results and unavailable artifacts require model execution."
}
